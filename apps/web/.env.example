# Must share the same host as BETTER_AUTH_URL and WEB_URL in
# apps/api/.dev.vars, and as the URL you open the web app with.
# Better Auth stores the OAuth state + session cookies on this host and the
# Google callback redirects to BETTER_AUTH_URL; mixing hosts (127.0.0.1 vs
# localhost) means the browser never sends the state cookie back and sign-in
# fails with "State not persisted correctly".
VITE_API_URL=http://localhost:8787
