DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DB_NAME?sslmode=require"
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
# IMPORTANT: BETTER_AUTH_URL, WEB_URL and the web app's VITE_API_URL must all
# share the same host (all localhost or all 127.0.0.1). The Google OAuth
# callback redirects to BETTER_AUTH_URL, while the state/session cookies are
# set on the host the browser calls (VITE_API_URL); if they differ the state
# cookie is not sent back and sign-in fails with "State not persisted correctly".
# Also add http://localhost:8787/api/auth/callback/google to the Google OAuth
# client's authorized redirect URIs.
BETTER_AUTH_URL="http://localhost:8787"
WEB_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxx"
ADMIN_KEY="a-long-random-secret-key"
# Razorpay (Test mode keys from Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="secret-xxxxxxxxxxxxxxxx"
# Only needed for the webhook endpoint, which must be publicly reachable.
# Generated in Dashboard > Settings > Webhooks when you add the webhook URL.
# Safe to leave empty in local dev.
RAZORPAY_WEBHOOK_SECRET=""
# Direct-to-R2 uploads (presigned PUT URLs). Create an R2 API token with
# "Object Read & Write" on liza-arch-storage + testing-bucket.
# In production set these with `wrangler secret put <NAME>`.
CF_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="xxx"
R2_SECRET_ACCESS_KEY="xxx"
# Must match the bucket the BUCKET binding uses in dev (preview_bucket_name).
R2_BUCKET_NAME="testing-bucket"
